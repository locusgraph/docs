{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "locusgraph-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Keep the workers.dev hostname. Declaring `routes` alone turns it off, which
  // takes the site offline the moment a custom domain fails to attach.
  "workers_dev": true,
  // Attached here rather than in the dashboard so the hostname is versioned with
  // the worker that serves it. Cloudflare provisions the certificate and the DNS
  // record itself, which it will only do for a name nothing else holds.
  //
  // `doc.locusgraph.com` is the old docs host, held by a CNAME to Vercel. Run
  // from a terminal, `wrangler deploy` asks "Update them to point to this script
  // instead?" and answering yes replaces that record with the worker's own. Run
  // without one, it overrides without asking. Once attached, the app answers
  // every path on it with a redirect, mapped in `lib/site/legacy.ts`.
  "routes": [
    {
      "pattern": "docs.locusgraph.com",
      "custom_domain": true
    },
    {
      "pattern": "doc.locusgraph.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
